# Backend runtime configuration
MONGO_URL=
DB_NAME=adelfos

# Comma-separated frontend origins. Use the deployed frontend URL in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://adelfosmarketing.com

# Required for the protected admin dashboard.
ADMIN_API_TOKEN=replace-with-a-long-random-token

# Optional email notifications via Resend.
RESEND_API_KEY=
SENDER_EMAIL=
NOTIFY_EMAIL=
